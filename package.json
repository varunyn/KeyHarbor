{
  "name": "keyharbor",
  "version": "2.1.1",
  "description": "A free local secrets workspace for developers, with configuration checks and approved CLI/MCP access.",
  "homepage": "https://github.com/varunyn/KeyHarbor",
  "bugs": {
    "url": "https://github.com/varunyn/KeyHarbor/issues"
  },
  "license": "MIT",
  "author": "Varun Yadav",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/varunyn/KeyHarbor.git"
  },
  "bin": {
    "keyharbor": "./backend-build/cli/keyharbor.js",
    "keyharbor-mcp": "./backend-build/cli/keyharbor-mcp.mjs"
  },
  "main": "backend-build/src/main.js",
  "scripts": {
    "start": "electron .",
    "prestart": "npm run build:renderer && npm run build:backend -- --require-renderer",
    "test": "npm run build:backend && node --test --test-concurrency=1 backend-build/test/*.test.js backend-build/test/*.test.mjs",
    "build:backend": "node -e \"require('node:fs').rmSync('backend-build', { recursive: true, force: true })\" && tsc -p tsconfig.backend.json && node backend-build/scripts/copy-backend-resources.mjs",
    "lint": "npm run build:backend && node backend-build/scripts/lint.mjs",
    "lint:js": "ultracite check",
    "lint:css": "stylelint \"src/**/*.{css,html}\"",
    "mcp": "node ./backend-build/cli/keyharbor-mcp.mjs",
    "build": "npm run build:mac && npm run build:win",
    "build:renderer": "npm run typecheck:renderer && vite build",
    "typecheck:renderer": "tsc --noEmit",
    "build:desktop": "npm run build:renderer && npm run build:backend -- --require-renderer",
    "build:mac": "npm run build:desktop && electron-builder --mac",
    "build:win": "npm run build:desktop && electron-builder --win",
    "build:linux": "npm run build:desktop && electron-builder --linux",
    "check": "ultracite check",
    "check:backend": "ultracite check src/main.ts src/preload.ts src/modules cli scripts test && tsc -p tsconfig.backend.json --noEmit",
    "fix": "oxfmt --write"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.0",
    "electron-context-menu": "^5.1.0",
    "electron-window-state": "^5.0.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-slot": "^1.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "lucide-react": "^1.50.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "postcss-html": "2.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "stylelint": "17.16.0",
    "stylelint-config-recommended": "18.0.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "ultracite": "^7.12.2",
    "vite": "8.3.2"
  },
  "overrides": {
    "config-file-ts": {
      "glob": "^10.5.0"
    },
    "js-yaml": "^4.1.1",
    "minimatch": "^10.2.1"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "build": {
    "appId": "com.keyharbor.app",
    "productName": "KeyHarbor",
    "directories": {
      "output": "dist"
    },
    "files": [
      "backend-build/src/**/*",
      "backend-build/cli/**/*",
      "backend-build/package.json",
      "src/renderer-build/**/*",
      "node_modules/@modelcontextprotocol/**/*",
      "node_modules/zod/**/*",
      "LICENSE",
      "src/renderer/ui/LICENSE.md"
    ],
    "asarUnpack": [
      "**/node_modules/electron-context-menu/**",
      "**/node_modules/electron-dl/**",
      "**/node_modules/ext-name/**"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "src/assets/macicon.png",
      "identity": null
    },
    "dmg": {
      "artifactName": "${productName}-macOS-${version}.${ext}"
    },
    "win": {
      "target": "nsis",
      "icon": "src/assets/icon.png"
    },
    "nsis": {
      "artifactName": "${productName}-Windows-${version}.${ext}"
    },
    "linux": {
      "target": "AppImage",
      "icon": "src/assets/icon.png"
    },
    "afterPack": "./scripts/sign-adhoc.js"
  }
}
